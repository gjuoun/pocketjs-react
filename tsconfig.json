{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "types": ["bun"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": true,
    "paths": {
      "@pocket-internal/*": ["./node_modules/@pocketjs/framework/*"],
      "pocketjs-react": ["./src/index.ts"],
      "pocketjs-react/radix": ["./src/primitives/radix.ts"],
      "pocketjs-react/glyph-icons": ["./src/primitives/glyph-icons.tsx"]
    }
  },
  "include": ["src", "test", "tools", "examples"]
}
